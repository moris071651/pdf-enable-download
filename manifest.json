{
    "manifest_version": 3,
    "name": "Viewer.js Enhancer",
    "version": "1.1",
    "description": "Unhides Print and Download buttons in Viewer.js",
    "permissions": [
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "index.js"
            ],
            "run_at": "document_idle"
        }
    ]
}